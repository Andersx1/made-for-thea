{
  "name": "made-for-thea",
  "productName": "Made for Thea",
  "version": "0.7.3",
  "description": "Draft sewing patterns from your measurements, print them at true scale, and plan your sewing.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.clothesdesigner.app",
    "productName": "Made for Thea",
    "afterPack": "tools/mac-adhoc-sign.js",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/three/build/three.module.js",
      "node_modules/three/package.json"
    ],
    "fileAssociations": [
      {
        "ext": "clothes",
        "name": "Made for Thea project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "three": "^0.169.0"
  }
}
